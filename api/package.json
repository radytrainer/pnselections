{
  "name": "scholarship-tracker-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Scholarship Selection Tracker (Express + PostgreSQL + Redis)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "migrate-storage": "node dist/scripts/migrate-storage.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^4.15.9"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "firebase-admin": "^14.0.0",
    "ioredis": "^5.6.1",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
