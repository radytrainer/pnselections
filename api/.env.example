# Local development of the API outside Docker (npm run dev in api/).
# Start the databases first from the repo root:  docker compose up -d postgres redis
# then: cp api/.env.example api/.env  (match the passwords in the root .env)

PORT=4000
NODE_ENV=development

# Runtime role (least privilege, created by the migrator)
DATABASE_URL=postgres://app_api:change-me-app@localhost:5432/scholarship
# Owner role, used only by `npm run migrate:dev`
MIGRATION_DATABASE_URL=postgres://postgres:change-me-postgres@localhost:5432/scholarship
APP_DB_USER=app_api
APP_DB_PASSWORD=change-me-app

REDIS_URL=redis://:change-me-redis@localhost:6379

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
TRUST_PROXY=1
