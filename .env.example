# =============================================================================
# Scholarship Selection Tracker — environment for docker compose
# Copy to .env (or run ./scripts/init-env.sh, which also generates passwords).
# Use URL-safe passwords (letters/digits) — they're embedded in connection URLs.
# =============================================================================

# --- Public site address (Caddy) ---------------------------------------------
# ":80"                 -> plain HTTP (local, or behind an AWS ALB that terminates TLS)
# "tracker.example.org" -> automatic HTTPS via Let's Encrypt (ports 80+443 must be open)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL (container) --------------------------------------------------
POSTGRES_DB=scholarship
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
# Least-privilege role the API logs in as (created by the migrate service).
APP_DB_USER=app_api
APP_DB_PASSWORD=change-me-app
# Load provinces/roles/2026 cycle reference data on migrate (idempotent).
SEED_REFERENCE_DATA=true

# --- Redis (container) -------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# --- Firebase (authentication stays on Firebase) -----------------------------
# Public web config — inlined into the browser bundle at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Admin SDK service account — server-only (API container). Paste private_key
# on one line with literal \n sequences, wrapped in double quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- File storage (logos, avatars, student photos) ---------------------------
# local -> Docker volume "storage" (single server)
# s3    -> Amazon S3 bucket (recommended on AWS; use an EC2 instance role, no keys)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-southeast-1
# Only for S3-compatible services other than AWS:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Only when not using an IAM instance role:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- API tuning ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=1200
# Proxies in front of the API: 1 = Caddy only, 2 = ALB -> Caddy
TRUST_PROXY=1

# --- Backups (scripts/backup-db.sh) ------------------------------------------
# Optional: also copy each dump to S3, e.g. s3://my-backups/scholarship-tracker
BACKUP_S3_URI=
BACKUP_RETENTION_DAYS=14
